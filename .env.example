# 数据库
BISTRO_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/bistro

# 模型层：mock 无需联网即可跑通整条链路。
# 接真实模型时改成 deepseek（或 openai_compat），并填上自己的密钥。
# 密钥只填在 .env 里，.env 已在 .gitignore 中，不要写进这里。
BISTRO_LLM_PROVIDER=mock

# DeepSeek 的配置示例（把上面一行改成 deepseek 才会生效）：
# BISTRO_LLM_PROVIDER=deepseek
# BISTRO_LLM_BASE_URL=https://api.deepseek.com/v1   # 留空则用官方默认地址
# BISTRO_LLM_API_KEY=
# BISTRO_LLM_MODEL=deepseek-v4-flash
# BISTRO_LLM_THINKING=auto                          # auto | disabled

# 任意其它 OpenAI 兼容接口（OpenAI、Qwen、自建 vLLM…）
# BISTRO_LLM_PROVIDER=openai_compat
# BISTRO_LLM_BASE_URL=https://api.openai.com/v1
# BISTRO_LLM_API_KEY=

# mock 也会用到下面两项，接真实模型时按需覆盖
BISTRO_LLM_MODEL=gpt-4o-mini
BISTRO_LLM_TEMPERATURE=0.85
